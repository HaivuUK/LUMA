<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Luma" Manufacturer="Luma" Version="$(var.Version)" UpgradeCode="9A3B53E2-2342-4A8E-892D-23FBCB821A12">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Luma is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Luma">
        <Component Id="MainExecutable" Guid="41B2D2B1-4A53-4882-9B7C-D3F2A11109B3">
          <File Id="LumaExe" Source="target\x86_64-pc-windows-msvc\release\luma.exe" KeyPath="yes" />
          <!-- Appends folder to System PATH so 'luma' runs from PowerShell/cmd -->
          <Environment Id="UpdatePath" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>